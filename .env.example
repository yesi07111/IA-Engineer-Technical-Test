# Model in "provider:model" format. The project was developed and evaluated with
# google_genai:gemini-3.5-flash (free tier in Google AI Studio). Other examples:
#   anthropic:claude-sonnet-5-5
#   openai:<model-name>
#   ollama:<model-name>
EMPORIO_MODEL=google_genai:gemini-3.5-flash

# Only the key of the provider you picked is needed.
# For Gemini, create one at https://aistudio.google.com (Get API key).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional, max model calls per minute. The Gemini free tier allows 5.
EMPORIO_REQUESTS_PER_MINUTE=5

# Optional, leave empty to use the model default (some models only accept the default)
EMPORIO_TEMPERATURE=

EMPORIO_DATA_DIR=data
EMPORIO_MEMORY_DB=.memory/conversations.sqlite
EMPORIO_TICKETS_FILE=.memory/handoff_tickets.jsonl
EMPORIO_TIMEZONE=America/Campo_Grande
